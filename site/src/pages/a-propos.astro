---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const chapo =
  "Netair conçoit et fabrique des filtres pour les centrales de traitement d'air, du préfiltre au filtre absolu. Fondée en 2026 par Pierre-Alain Duclos, fort de plus de 20 ans d'expérience dans la filtration de l'air, l'entreprise accompagne les installateurs, exploitants et industriels dans le choix des solutions de filtration adaptées à leurs installations, en conciliant qualité de l'air, performance énergétique et durée de vie des filtres.";

const raisonDEtre =
  "Chez NETAIR, nous sommes convaincus qu'une filtration de l'air performante doit aller de pair avec une consommation énergétique maîtrisée. Notre ambition est de proposer des solutions adaptées aux besoins réels de chaque installation, en privilégiant la qualité de l'air, les économies d'énergie et la réduction de l'empreinte environnementale.";

const modele =
  "NETAIR associe ses capacités de fabrication et d'assemblage à un réseau de partenaires industriels spécialisés. Cette organisation flexible nous permet de proposer une gamme complète de filtres, en dimensions standard ou sur mesure, tout en privilégiant la qualité, la réactivité et la fiabilité des approvisionnements.";

const citation =
  "La filtration joue un rôle essentiel dans la performance des installations, la qualité de l'air et la maîtrise des consommations énergétiques. C'est cette conviction qui guide nos choix et notre engagement au quotidien.";

const engagements = [
  {
    titre: 'Performance et efficacité énergétique',
    texte:
      "Nous sélectionnons et développons des solutions de filtration associant efficacité, faible perte de charge et durée de vie optimisée. Notre objectif : une qualité d'air adaptée à chaque installation, avec des consommations énergétiques réduites.",
  },
  {
    titre: 'Proximité et accompagnement',
    texte:
      "Chaque installation présente des contraintes spécifiques. Nous privilégions l'écoute, le conseil technique et la disponibilité pour accompagner nos clients dans le choix de leurs filtres, l'optimisation de leurs installations et le suivi de leurs besoins.",
  },
  {
    titre: 'Une filtration plus responsable',
    texte:
      "Nous privilégions des solutions permettant de limiter l'impact environnemental de la filtration : réduction des consommations d'énergie, allongement de la durée de vie des filtres et développement de produits rechargeables pour diminuer les déchets.",
  },
];
---

<BaseLayout
  title="Qui sommes-nous - Netair"
  description="Netair conçoit et fabrique des filtres pour centrales de traitement d'air, du préfiltre au filtre absolu. Fondée en 2026 par Pierre-Alain Duclos, plus de 20 ans d'expérience dans la filtration de l'air."
>
  <section class="mx-auto max-w-[1140px] px-7 pt-10 pb-4">
    <Breadcrumb items={[{ href: '/', label: 'Accueil' }, { label: 'Qui sommes-nous' }]} />
    <h1 class="display mt-5 text-4xl sm:text-5xl font-normal text-marine max-w-3xl">
      NETAIR, l'expertise de la filtration de l'air
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{chapo}</p>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-8 grid gap-10 md:grid-cols-2">
    <div class="relative pl-5">
      <span class="absolute left-0 top-1 bottom-1 w-[3px] rounded-full bg-turquoise"></span>
      <h2 class="display text-2xl text-marine">Raison d'être</h2>
      <p class="mt-3 text-lg leading-relaxed text-muted">{raisonDEtre}</p>
    </div>
    <div class="relative pl-5">
      <span class="absolute left-0 top-1 bottom-1 w-[3px] rounded-full bg-turquoise"></span>
      <h2 class="display text-2xl text-marine">Notre modèle</h2>
      <p class="mt-3 text-lg leading-relaxed text-muted">{modele}</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-4">
    <figure class="rounded-2xl border border-soft bg-mist p-6 sm:p-8">
      <blockquote class="text-lg leading-relaxed text-marine">«&#8239;{citation}&#8239;»</blockquote>
      <figcaption class="mt-5 flex items-center gap-4">
        <img src="/img/pierre-alain-duclos.jpg" alt="Pierre-Alain Duclos, fondateur de Netair" width="64" height="64" class="h-16 w-16 rounded-full object-cover" />
        <div>
          <p class="text-base font-normal text-marine">Pierre-Alain Duclos</p>
          <p class="text-sm text-muted">Fondateur, Netair</p>
        </div>
      </figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-8">
    <h2 class="display text-3xl font-normal text-marine">Nos engagements</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {engagements.map((e, i) => (
        <div class="rounded-2xl border border-soft bg-blanc p-6">
          <div class="display text-sm text-muted">0{i + 1}</div>
          <h3 class="display mt-1 text-xl text-marine">{e.titre}</h3>
          <p class="mt-2 text-sm text-muted">{e.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-12">
    <div class="rounded-3xl border border-soft bg-mist px-8 py-14 text-center">
      <p class="display text-2xl sm:text-3xl font-normal text-marine">L'air propre, notre engagement.</p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/rendez-vous"
          class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
          style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Prendre rendez-vous
        </a>
        <a
          href="/gammes"
          class="inline-flex items-center gap-2 rounded-xl border border-soft bg-blanc px-6 py-3 text-sm font-normal text-marine transition-colors hover:border-turquoise"
        >
          Voir le catalogue →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
