---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

// Adresse de destination du message — À CONFIRMER (boîte contact Netair).
const CONTACT_EMAIL = 'contact@netair.fr';

// Coordonnées — à compléter dès l'immatriculation de la société.
const TELEPHONE = '[À COMPLÉTER]';
const ADRESSE = '[À COMPLÉTER]';
const HORAIRES = '[À COMPLÉTER] (ex. lun.–ven., 8 h–18 h)';

// Objets proposés dans le formulaire (tri des messages à l'arrivée).
const OBJETS = [
  'Renseignement produit',
  'Question sur une commande',
  'Service après-vente (SAV)',
  'Autre',
];
---

<BaseLayout
  title="Contactez-nous — Netair"
  description="Une question, un renseignement, un projet ? Contactez Netair, fabricant de filtres pour centrales de traitement d'air. Nous vous répondons rapidement."
>
  <section class="mx-auto max-w-[1140px] px-7 pt-10 pb-4">
    <Breadcrumb items={[{ href: '/', label: 'Accueil' }, { label: 'Contact' }]} />
    <h1 class="display mt-5 text-4xl sm:text-5xl font-normal text-marine">Contactez-nous</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Une question, un renseignement, un projet ? Écrivez-nous, nous vous répondons
      rapidement.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Vous cherchez un tarif ?{' '}
      <a href="/gammes" class="font-normal text-bleu hover:text-turquoise">Configurez et achetez en ligne</a>{' '}
      ou{' '}
      <a href="/devis" class="font-normal text-bleu hover:text-turquoise">demandez un devis</a>.
    </p>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-8 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
    <!-- Formulaire -->
    <form id="contact-form" class="rounded-2xl border border-soft bg-blanc p-6 sm:p-8">
      <div class="grid gap-5">
        <div>
          <label for="nom" class="block text-sm font-normal text-marine">Nom / société <span class="text-bleu">*</span></label>
          <input id="nom" name="nom" type="text" required autocomplete="organization"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div>
          <label for="email" class="block text-sm font-normal text-marine">Email <span class="text-bleu">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div>
          <label for="tel" class="block text-sm font-normal text-marine">Téléphone <span class="text-muted font-normal">(facultatif)</span></label>
          <input id="tel" name="tel" type="tel" autocomplete="tel"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div>
          <label for="objet" class="block text-sm font-normal text-marine">Objet <span class="text-bleu">*</span></label>
          <select id="objet" name="objet" required
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc">
            {OBJETS.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div>
          <label for="message" class="block text-sm font-normal text-marine">Votre message <span class="text-bleu">*</span></label>
          <textarea id="message" name="message" rows="5" required placeholder="Comment pouvons-nous vous aider ?"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc"></textarea>
        </div>
        <label class="flex items-start gap-3 text-sm text-muted">
          <input id="rgpd" name="rgpd" type="checkbox" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-turquoise)]" />
          <span>J'accepte que mes données soient utilisées pour traiter ma demande. <span class="text-bleu">*</span></span>
        </label>
        <div>
          <button type="submit" id="contact-submit"
            class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
            style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));">
            Envoyer mon message →
          </button>
          <p id="contact-ok" role="status" class="mt-3 hidden rounded-lg bg-turquoise/10 px-4 py-3 text-sm font-normal text-marine">
            Merci, votre message a bien été envoyé. Nous vous répondons rapidement.
          </p>
          <p id="contact-note" class="mt-3 text-xs text-muted">
            Nous vous répondons par email ou par téléphone.
          </p>
        </div>
      </div>
    </form>

    <!-- Coordonnées -->
    <aside class="space-y-6">
      <div class="rounded-2xl border border-soft bg-mist p-6">
        <h2 class="eyebrow text-xs text-turquoise">Nous joindre</h2>
        <dl class="mt-3 space-y-3 text-sm">
          <div>
            <dt class="text-muted">Email</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`} class="font-normal text-marine hover:text-turquoise">{CONTACT_EMAIL}</a></dd>
          </div>
          <div>
            <dt class="text-muted">Téléphone</dt>
            <dd class="font-normal text-marine">{TELEPHONE}</dd>
          </div>
        </dl>
      </div>
      <div class="rounded-2xl border border-soft bg-blanc p-6">
        <h2 class="eyebrow text-xs text-turquoise">Adresse</h2>
        <p class="mt-3 text-sm font-normal text-marine">{ADRESSE}</p>
      </div>
      <div class="rounded-2xl border border-soft bg-blanc p-6">
        <h2 class="eyebrow text-xs text-turquoise">Horaires</h2>
        <p class="mt-3 text-sm font-normal text-marine">{HORAIRES}</p>
      </div>
      <div class="rounded-2xl border border-soft bg-mist p-6">
        <h2 class="eyebrow text-xs text-turquoise">Vous préférez un rendez-vous ?</h2>
        <p class="mt-3 text-sm text-muted">Échangez de vive voix avec un conseiller, par téléphone ou en visio — gratuit et sans engagement.</p>
        <a href="/rendez-vous" class="mt-4 inline-flex items-center gap-2 rounded-xl border border-soft bg-blanc px-5 py-2.5 text-sm font-normal text-marine transition-colors hover:border-turquoise">
          <svg class="h-4 w-4 text-turquoise" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Réserver un créneau
        </a>
      </div>
    </aside>
  </section>

  <script define:vars={{ CONTACT_EMAIL }}>
    const form = document.getElementById('contact-form');
    const okNote = document.getElementById('contact-ok');
    const helpNote = document.getElementById('contact-note');
    const submitBtn = document.getElementById('contact-submit');

    const val = (id) => (document.getElementById(id)?.value || '').trim();

    // Repli : ouvre la messagerie du visiteur avec le message pré-rempli.
    // Utilisé tant que l'envoi serveur (/api/contact) n'est pas encore branché
    // (site statique aujourd'hui — voir server/contact-endpoint.ts).
    const ouvrirMessagerie = (data) => {
      const subject = `Contact — ${data.objet} — ${data.nom}`;
      const body =
        `Nom / société : ${data.nom}\n` +
        `Email : ${data.email}\n` +
        `Téléphone : ${data.tel || '—'}\n` +
        `Objet : ${data.objet}\n\n` +
        `Message :\n${data.message}\n`;
      window.location.href =
        `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = {
        nom: val('nom'),
        email: val('email'),
        tel: val('tel'),
        objet: val('objet'),
        message: val('message'),
      };

      // Tente l'envoi serveur ; si indisponible (site statique / hors ligne),
      // on retombe proprement sur l'ouverture de la messagerie.
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('endpoint indisponible');
        form.reset();
        okNote?.classList.remove('hidden');
        helpNote?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;
      } catch {
        ouvrirMessagerie(data);
      }
    });
  </script>
</BaseLayout>
