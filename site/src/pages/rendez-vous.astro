---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

// Adresse de destination de la demande — À CONFIRMER (boîte contact Netair).
const CONTACT_EMAIL = 'contact@netair.fr';

// Téléphone — à compléter dès l'immatriculation de la société.
const TELEPHONE = '[À COMPLÉTER]';

const FORMATS = ['Par téléphone', 'En visio'];
const CRENEAUX = ['Peu importe', 'Matin (9 h–12 h)', 'Après-midi (14 h–18 h)'];
---

<BaseLayout
  title="Prendre rendez-vous avec un conseiller — Netair"
  description="Échangez 15 minutes avec un expert filtration Netair, par téléphone ou en visio. Gratuit et sans engagement : on vous aide à choisir le bon filtre pour votre installation."
>
  <section class="mx-auto max-w-[1140px] px-7 pt-10 pb-4">
    <Breadcrumb items={[{ href: '/', label: 'Accueil' }, { label: 'Rendez-vous' }]} />
    <h1 class="display mt-5 text-4xl sm:text-5xl font-normal text-marine">Prendre rendez-vous avec un conseiller</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Échangez 15 minutes avec un expert filtration Netair, par téléphone ou en visio.
      Gratuit et sans engagement : on vous aide à choisir le bon filtre pour votre installation.
    </p>
  </section>

  <!-- Les deux formats proposés — cliquables : pré-sélectionnent le format et mènent au formulaire -->
  <section class="mx-auto max-w-[1140px] px-7 py-4 grid gap-5 sm:grid-cols-2">
    <a href="#rdv-form" data-format="Par téléphone" class="group rounded-2xl border border-soft bg-blanc p-6 transition-colors hover:border-turquoise">
      <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-mist text-turquoise">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
      <h2 class="mt-4 text-lg font-normal text-marine">Par téléphone</h2>
      <p class="mt-1.5 text-sm text-muted">Un conseiller vous rappelle au créneau qui vous arrange.</p>
      <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-normal text-turquoise">Choisir ce format
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>
    <a href="#rdv-form" data-format="En visio" class="group rounded-2xl border border-soft bg-blanc p-6 transition-colors hover:border-turquoise">
      <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-mist text-turquoise">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 7-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      </span>
      <h2 class="mt-4 text-lg font-normal text-marine">En visio</h2>
      <p class="mt-1.5 text-sm text-muted">Partagez plans et schémas à l'écran pour un conseil précis.</p>
      <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-normal text-turquoise">Choisir ce format
        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </a>
  </section>

  <!-- Calendrier de réservation en ligne (emplacement Cal.com — à activer) -->
  <section class="mx-auto max-w-[1140px] px-7 py-4">
    <div class="rounded-2xl border border-soft bg-blanc p-6 sm:p-8">
      <h2 class="eyebrow text-xs text-turquoise">Réserver un créneau en ligne</h2>
      {/*
        EMPLACEMENT CALENDRIER Cal.com — À ACTIVER (après création du compte) :
        1. Sur cal.com : créer 2 types d'événement (« Téléphone — 15 min », « Visio — 15 min »),
           puis connecter le calendrier iCloud/iCal (Settings > Calendars) pour la synchro
           automatique des disponibilités (créneaux libres affichés, créneaux occupés masqués).
        2. Remplacer le bloc #cal-booking ci-dessous par l'embed « inline » Cal.com
           (conteneur + script). Doc : https://cal.com/docs/core-features/embed
        3. Faire pointer les blocs « Par téléphone » / « En visio » (data-format) vers le
           type d'événement correspondant.
      */}
      <div id="cal-booking" class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-soft bg-mist px-6 py-12 text-center">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-blanc text-turquoise">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </span>
        <p class="mt-4 text-sm font-normal text-marine">La réservation en ligne arrive bientôt.</p>
        <p class="mt-1 text-sm text-muted">En attendant, remplissez le formulaire ci-dessous ou appelez-nous.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1140px] px-7 py-8 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
    <!-- Formulaire de demande de rendez-vous -->
    <form id="rdv-form" class="rounded-2xl border border-soft bg-blanc p-6 sm:p-8">
      <h2 class="text-xl font-normal text-marine">Demander un rendez-vous</h2>
      <p class="mt-1.5 text-sm text-muted">Laissez vos coordonnées : un conseiller vous recontacte pour fixer le rendez-vous.</p>
      <div class="mt-6 grid gap-5">
        <div>
          <label for="nom" class="block text-sm font-normal text-marine">Nom / société <span class="text-bleu">*</span></label>
          <input id="nom" name="nom" type="text" required autocomplete="organization"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div>
          <label for="tel" class="block text-sm font-normal text-marine">Téléphone <span class="text-bleu">*</span></label>
          <input id="tel" name="tel" type="tel" required autocomplete="tel"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div>
          <label for="email" class="block text-sm font-normal text-marine">Email <span class="text-muted font-normal">(facultatif)</span></label>
          <input id="email" name="email" type="email" autocomplete="email"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="format" class="block text-sm font-normal text-marine">Format souhaité <span class="text-bleu">*</span></label>
            <select id="format" name="format" required
              class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc">
              {FORMATS.map((f) => <option value={f}>{f}</option>)}
            </select>
          </div>
          <div>
            <label for="creneau" class="block text-sm font-normal text-marine">Créneau préféré</label>
            <select id="creneau" name="creneau"
              class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc">
              {CRENEAUX.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-normal text-marine">Sujet de l'échange <span class="text-muted font-normal">(facultatif)</span></label>
          <textarea id="message" name="message" rows="3" placeholder="Type d'installation, débit, classe recherchée…"
            class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-3 text-sm text-marine outline-none focus:border-turquoise focus:bg-blanc"></textarea>
        </div>
        <label class="flex items-start gap-3 text-sm text-muted">
          <input id="rgpd" name="rgpd" type="checkbox" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-turquoise)]" />
          <span>J'accepte que mes données soient utilisées pour traiter ma demande. <span class="text-bleu">*</span></span>
        </label>
        <div>
          <button type="submit" id="rdv-submit"
            class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
            style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));">
            Demander un rendez-vous →
          </button>
          <p id="rdv-ok" role="status" class="mt-3 hidden rounded-lg bg-turquoise/10 px-4 py-3 text-sm font-normal text-marine">
            Merci, votre demande est bien reçue. Un conseiller vous recontacte pour fixer le rendez-vous.
          </p>
        </div>
      </div>
    </form>

    <!-- Aside : bénéfices + agenda à venir + contact direct -->
    <aside class="space-y-6">
      <div class="rounded-2xl border border-soft bg-mist p-6">
        <h2 class="eyebrow text-xs text-turquoise">Ce que ça vous apporte</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-turquoise"></span>Gratuit et sans engagement</li>
          <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-turquoise"></span>15 minutes, à votre rythme</li>
          <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-turquoise"></span>Un expert, pas un script</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-soft bg-blanc p-6">
        <h2 class="eyebrow text-xs text-turquoise">Contact direct</h2>
        <p class="mt-3 text-sm text-muted">Vous préférez nous joindre directement :</p>
        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-muted">Téléphone</dt>
            <dd class="font-normal text-marine">{TELEPHONE}</dd>
          </div>
          <div>
            <dt class="text-muted">Email</dt>
            <dd><a href={`mailto:${CONTACT_EMAIL}`} class="font-normal text-marine hover:text-turquoise">{CONTACT_EMAIL}</a></dd>
          </div>
        </dl>
      </div>
    </aside>
  </section>

  <script define:vars={{ CONTACT_EMAIL }}>
    const form = document.getElementById('rdv-form');
    const okNote = document.getElementById('rdv-ok');
    const submitBtn = document.getElementById('rdv-submit');

    const val = (id) => (document.getElementById(id)?.value || '').trim();

    // Blocs « Par téléphone » / « En visio » : pré-sélectionnent le format dans le
    // formulaire ; l'ancre href="#rdv-form" fait défiler jusqu'à lui.
    const formatSelect = document.getElementById('format');
    document.querySelectorAll('[data-format]').forEach((el) => {
      el.addEventListener('click', () => {
        const fmt = el.getAttribute('data-format');
        if (formatSelect && fmt) formatSelect.value = fmt;
      });
    });

    const composerMessage = (d) =>
      `Format souhaité : ${d.format}\n` +
      `Créneau préféré : ${d.creneau}\n` +
      (d.message ? `\nSujet :\n${d.message}\n` : '');

    // Repli : ouvre la messagerie du visiteur tant que l'envoi serveur (/api/contact)
    // n'est pas branché (site statique — voir server/contact-endpoint.ts).
    const ouvrirMessagerie = (d) => {
      const subject = `Rendez-vous — ${d.format} — ${d.nom}`;
      const body =
        `Nom / société : ${d.nom}\n` +
        `Téléphone : ${d.tel}\n` +
        `Email : ${d.email || '—'}\n\n` +
        composerMessage(d);
      window.location.href =
        `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = {
        nom: val('nom'),
        tel: val('tel'),
        email: val('email'),
        format: val('format'),
        creneau: val('creneau'),
        message: val('message'),
      };
      const payload = {
        nom: d.nom,
        email: d.email,
        tel: d.tel,
        objet: 'Prise de rendez-vous',
        message: composerMessage(d),
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('endpoint indisponible');
        form.reset();
        okNote?.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = true;
      } catch {
        ouvrirMessagerie(d);
      }
    });
  </script>
</BaseLayout>
