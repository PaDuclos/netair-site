---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import {
  getProduits,
  familleBySlug,
  SLUG_FAMILLE,
  type Produit,
} from '../../lib/familles';
import { gammeDuProduit, produitsSansCadresDeclares, formatsAuxCadresInconnus } from '../../lib/pricing/produits-gammes';
import { optionsDuCode, formatsDuCode, libelleClasse, efficaciteFigee, comparerClasses } from '../../lib/pricing/options';
import { trouverGamme } from '../../lib/pricing/lookups';
import { MIN_COMMANDE_HT } from '../../lib/boutique';

export async function getStaticPaths() {
  const produits = await getProduits();
  return produits.map((p) => ({ params: { ref: p.id }, props: { produit: p } }));
}

interface Props {
  produit: Produit;
}
const { produit } = Astro.props;
const d = produit.data;

const famille = familleBySlug(SLUG_FAMILLE[produit.id]?.[0] ?? '');
const img = d.photo ? `/produits/${d.photo}` : null;

// Lien vers la fiche technique générée (servie depuis /public/fiches-techniques/).
const ficheHref = `/fiches-techniques/${encodeURIComponent(`Fiche technique ${d.nom}.html`)}`;

const badges: string[] = d.badges_p1 ?? [];
const specs: string[][] = d.specs ?? [];
const points: string[] = d.points_cles ?? [];
// Base de la référence : espaces du nom → underscores pour rester lisible
// (ex. « NETPAK S CILIA » → « NETPAK_S_CILIA », pas « NETPAKSCILIA »).
const codeBase = d.nom.replace(/\s+/g, '_');

// Fil d'Ariane (source unique : sert à l'affichage ET aux données structurées SEO).
const filAriane = [
  { href: '/', label: 'Accueil' },
  { href: '/gammes', label: 'Gammes' },
  ...(famille ? [{ href: `/gammes/${famille.slug}`, label: famille.titre }] : []),
  { label: d.nom },
];

// Données structurées (schema.org) pour les moteurs de recherche : fiche produit
// (SANS prix — tarifs dynamiques / sur-mesure, on n'affiche pas de prix figé) + fil d'Ariane.
const siteBase = Astro.site ?? new URL('https://netair.fr');
const absUrl = (path: string) => new URL(path, siteBase).href;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nom,
  ...(d.description ? { description: d.description.slice(0, 300) } : {}),
  ...(img ? { image: absUrl(img) } : {}),
  ...(famille ? { category: famille.titre } : {}),
  brand: { '@type': 'Brand', name: 'Netair' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: filAriane.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: absUrl(c.href) } : {}),
  })),
};

// --- Pont vers le moteur de prix (Bloc B2) ---
// On relie le produit du site à sa gamme tarifaire. `mode` = "calcul" (prix instantané)
// ou "devis" (gamme hors calculateur → demande de devis seule). Produit non répertorié
// → on reste prudent : pas de prix public.
const gamme = gammeDuProduit(produit.id);
const modeProduit: 'calcul' | 'devis' = gamme?.mode ?? 'devis';
const codeGamme = gamme?.code ?? '';

// Menus du configurateur : TOUJOURS lus dans le calculateur (concordance, décision PA :
// « le configurateur ne référence que le calculateur »). On ne propose QUE les efficacités
// et épaisseurs réellement présentes dans les tables — jamais de valeurs génériques. Un
// produit sur devis n'affiche un champ que si le calculateur a l'info (sinon rien).
// Dimensions ouvertes par défaut (592×592 sauf produits à formats standard, ex. laminaire 610×610).
const dimDefaut = gamme?.dimensionDefaut ?? { largeur: 592, hauteur: 592 };
// Cadres proposés : lus dans la fiche du produit, JAMAIS devinés. Pas de repli par défaut —
// un défaut « acier + polypropylène » proposait en silence des cadres inexistants (cf.
// `produits-gammes.ts`). Un produit calculable mal déclaré casse le build (tous les fautifs
// signalés d'un coup) plutôt que d'afficher un cadre faux au client.
const cadres = gamme?.cadres ?? [];
// Cadre imposé (ex. NETPLY = acier galvanisé) : affiché en information, jamais en menu.
const cadreFixe = gamme?.cadreFixe ?? null;
// « Cadre » par défaut ; NETMETAL vend un couple cadre + tricot → « Matière ».
const labelCadre = gamme?.labelCadre ?? 'Cadre';
const fautifs = produitsSansCadresDeclares();
if (fautifs.length > 0) {
  throw new Error(
    `Cadres non déclarés pour : ${fautifs.join(', ')}. Renseigner « cadres » dans produits-gammes.ts ` +
      `d'après la ligne « Cadre » de la fiche technique, ou « sansCadre: true » si le cadre est unique.`,
  );
}
// Un format ne peut restreindre le cadre qu'à des matières que le produit propose déjà : sinon
// le filtre du configurateur ne rendrait rien et retomberait sur le menu complet, en silence.
const cadresFormatsFautifs = formatsAuxCadresInconnus();
if (cadresFormatsFautifs.length > 0) {
  throw new Error(
    `Cadres de format inconnus : ${cadresFormatsFautifs.join(' ; ')}. Le « cadres » d'un format doit ` +
      `être un sous-ensemble du « cadres » du produit, dans produits-gammes.ts.`,
  );
}
// Filtrage des efficacités proposées : liste blanche (`classesIncluses`, ex. laminaire = H14)
// puis liste noire (`classesExclues`, ex. NETFIBRE G3 douteux). Sinon, toutes les tarifées.
const classesIncluses = gamme?.classesIncluses ?? null;
const classesExclues = gamme?.classesExclues ?? [];
// Étiquettes ISO propres au produit (`etiquettesIso`) : priment sur la table globale de
// l'Excel — la fiche technique fait foi (ex. BORA F7 = ePM1 50 %, média spécial).
const etiquetteIso = gamme?.etiquettesIso ?? {};
const filtreClasses = (classes: { valeur: string; libelle: string }[]) =>
  classes
    .filter((c) => !classesIncluses || classesIncluses.includes(c.valeur))
    .filter((c) => !classesExclues.includes(c.valeur))
    .map((c) => ({ ...c, libelle: etiquetteIso[c.valeur] ?? c.libelle }));

// Options lues dans le calculateur, pour les produits calculables ET sur devis.
const optsReelles = codeGamme ? optionsDuCode(codeGamme) : null;
const classesCalc = filtreClasses(optsReelles?.classes ?? []);
// Stopgap : efficacités d'un produit sur devis non encore saisi au calculateur (ex. BORA G4→F9),
// pour que le client précise son besoin de filtration. À retirer quand l'Excel les couvre.
const classesStopgap = (gamme?.efficacitesDevis ?? []).map((v) => ({ valeur: v, libelle: etiquetteIso[v] ?? libelleClasse(v) }));
// Classes annoncées par la fiche mais non tarifées (ex. NETBAG S G4/M5) : ajoutées au menu d'un
// produit calculable, à leur rang EN 779, pour partir en devis faute de prix.
const classesHorsTarif = (gamme?.classesSurDevis ?? [])
  .filter((v) => !classesCalc.some((c) => c.valeur === v))
  .map((v) => ({ valeur: v, libelle: etiquetteIso[v] ?? libelleClasse(v) }));
const menus = {
  classes:
    classesCalc.length > 0
      ? [...classesCalc, ...classesHorsTarif].sort((a, b) => comparerClasses(a.valeur, b.valeur))
      : classesStopgap,
  epaisseurs: optsReelles?.epaisseurs ?? [],
};
// Épaisseurs : celles du calculateur ; à défaut, stopgap `epaisseursDevis` (ex. BORA 100 mm,
// en attendant que l'épaisseur soit ajoutée au calculateur — cf. CHECKLIST).
// Épaisseurs de la variante par défaut si elle en déclare (ex. NETBAG S standard = 380/550,
// sous-ensemble mesuré ET tarifé) ; sinon celles du calculateur, sinon le stopgap devis.
const epaisseursVarDefaut = gamme?.variantes?.[0]?.epaisseurs;
const epaisseursAffichees =
  epaisseursVarDefaut ?? (menus.epaisseurs.length > 0 ? menus.epaisseurs : (gamme?.epaisseursDevis ?? []));
// Épaisseur pré-sélectionnée : celle déclarée si elle est bien proposée, sinon la première
// du menu. L'ordre étant croissant, s'en remettre au premier reviendrait à pousser la plus fine.
const epDefaut = epaisseursAffichees.includes(gamme?.epaisseurDefaut as number)
  ? gamme!.epaisseurDefaut
  : epaisseursAffichees[0];

// Efficacité pré-sélectionnée : la « par défaut » de la gamme (colonne Excel `eff_defaut`)
// si elle est proposée, sinon la première du menu — plutôt que toujours la classe la plus basse.
const choisirEff = (classes: { valeur: string }[], code: string) => {
  const def = code ? trouverGamme(code)?.eff_defaut ?? '' : '';
  return classes.some((c) => c.valeur === def) ? def : classes[0]?.valeur ?? '';
};
const effSelection = choisirEff(menus.classes, codeGamme);

// Conditionnements multiples (ex. NETFIBRE panneau/rouleau) ou produit à formats
// (ex. laminaire). Pour chaque variante on calcule ici (côté serveur) les efficacités
// tarifées et, en mode "formats" sans liste explicite, les dimensions standard depuis
// la grille. Transmis au script via un attribut de données.
// Un produit SUR DEVIS peut aussi n'exister qu'en formats standard (ex. NETBAG S) : ses formats
// sont alors déclarés en dur dans `produits-gammes.ts`, faute de grille tarifaire où les lire.
const variantesConfig =
  gamme?.variantes
    ? gamme.variantes.map((v) => {
        // Sur devis, `optionsDuCode` ne rend rien (pas de code tarifaire) → on retombe sur les
        // efficacités déclarées, sinon le script client viderait le menu « Efficacité ».
        const classesCode = filtreClasses(optionsDuCode(v.code).classes);
        const classesBase = classesCode.length > 0 ? classesCode : classesStopgap;
        // Classes non tarifées annoncées par la fiche : mêmes règles que le menu principal.
        const classes =
          classesCode.length > 0 && classesHorsTarif.length > 0
            ? [...classesBase, ...classesHorsTarif].sort((a, b) => comparerClasses(a.valeur, b.valeur))
            : classesBase;
        const formatsBase =
          v.saisie === 'formats'
            ? v.formats ?? formatsDuCode(v.code, classes[0]?.valeur)
            : null;
        // formatsGrandDabord : premier = sélection par défaut → plein format en tête.
        const formatsOrdonnes =
          formatsBase && v.formatsGrandDabord ? [...formatsBase].reverse() : formatsBase;
        // formatDefaut : désigne le format d'ouverture par ses dimensions (les formats issus
        // de la grille ne peuvent pas porter `defaut` eux-mêmes). Ordre des côtés indifférent.
        let formats = formatsOrdonnes;
        if (formatsOrdonnes && v.formatDefaut) {
          const { largeur: fl, hauteur: fh } = v.formatDefaut;
          const i = formatsOrdonnes.findIndex(
            (f) => (f.largeur === fl && f.hauteur === fh) || (f.largeur === fh && f.hauteur === fl),
          );
          if (i < 0) {
            throw new Error(
              `formatDefaut ${fl}×${fh} absent de la grille du code ${v.code} (${produit.id}).`,
            );
          }
          formats = formatsOrdonnes.map((f, j) => (j === i ? { ...f, defaut: true } : f));
        }
        return { id: v.id, label: v.label, code: v.code, saisie: v.saisie, formats, classes, epaisseurs: v.epaisseurs ?? null, refBase: v.refBase ?? null, sansCadre: v.sansCadre ?? false, labelChamp: v.labelChamp ?? 'Dimensions', effSelection: choisirEff(classes, v.code) };
      })
    : null;

// Efficacité unique → champ figé (libellé affiché + valeur transmise au moteur), jamais un menu
// à une seule ligne : ce serait un faux choix. Règle et cas limites dans `efficaciteFigee`.
const effFixe = efficaciteFigee(menus.classes, variantesConfig?.map((v) => v.classes) ?? []);

// Produit vendu uniquement en formats standard (ex. polydièdre, laminaire) : l'intro
// « dimensions exactes / sur mesure » serait fausse — on annonce le choix d'un format.
const formatsSeuls =
  variantesConfig != null && variantesConfig.every((v) => v.saisie === 'formats');

// Intro du configurateur. Un produit sur devis n'a pas de prix : lui promettre d'« acheter au
// tarif catalogue » est faux (son bouton panier est désactivé). Trois cas distincts.
const introConfig =
  modeProduit === 'devis'
    ? (formatsSeuls
        ? 'Choisissez votre format standard et ajoutez ce filtre à votre demande de devis. Les autres dimensions sont étudiées sur demande.'
        : 'Précisez votre besoin et ajoutez ce filtre à votre demande de devis.')
    : (formatsSeuls
        ? 'Choisissez votre format standard : achetez au tarif catalogue, ou ajoutez à une demande de devis.'
        : 'Indiquez vos dimensions exactes : achetez au tarif catalogue, ou ajoutez à une demande de devis. Filtre fabriqué sur mesure.');
---

<BaseLayout
  title={`${d.nom} — ${d.soustitre ?? 'Filtre CTA'} | Netair`}
  description={(d.description ?? `${d.nom}, filtre pour centrale de traitement d'air.`).slice(0, 300)}
  ogImage={img ?? '/brand/logo.png'}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline></script>

  <!-- Bandeau maquette -->
  <div class="bg-marine text-blanc">
    <div class="mx-auto max-w-[1140px] px-7 py-2 text-center text-xs">
      Aperçu du site · prix catalogue HT réels mais <strong>indicatifs et non contractuels</strong> (avant mise en ligne)
    </div>
  </div>

  <section class="mx-auto max-w-[1140px] px-7 pt-10">
    <Breadcrumb items={filAriane} />
  </section>

  <!-- En-tête produit -->
  <section class="mx-auto max-w-[1140px] px-7 py-8 grid items-start gap-10 lg:grid-cols-2">
    {img && (
      <div class="rounded-2xl border border-soft bg-white p-6">
        <img src={img} alt={d.photo_alt ?? `Filtre ${d.nom}`} class="mx-auto h-auto w-full max-w-md object-contain" width="520" height="400" />
      </div>
    )}
    <div>
      {famille && <span class="eyebrow text-xs text-turquoise">{famille.titre}</span>}
      <h1 class="display mt-2 text-4xl sm:text-5xl font-normal text-marine">{d.nom}</h1>
      {d.soustitre && <p class="mt-2 text-lg text-muted">{d.soustitre}</p>}

      {badges.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {badges.map((b) => (
            <span class="rounded-lg bg-bleu/8 px-3 py-1.5 text-xs font-normal text-bleu">{b}</span>
          ))}
        </div>
      )}

      {points.length > 0 && (
        <ul class="mt-6 grid gap-2 sm:grid-cols-2">
          {points.map((pt) => (
            <li class="flex items-start gap-2 text-sm text-marine">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-turquoise"></span>
              {pt}
            </li>
          ))}
        </ul>
      )}

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#configurateur"
          class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
          style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));"
        >
          Configurer & commander →
        </a>
        <a
          href="#configurateur"
          class="inline-flex items-center gap-2 rounded-xl border border-soft bg-blanc px-5 py-3 text-sm font-normal text-marine transition-colors hover:border-turquoise"
        >
          Demander un devis
        </a>
        <a
          href={ficheHref}
          class="inline-flex items-center gap-2 rounded-xl border border-soft bg-blanc px-5 py-3 text-sm font-normal text-marine transition-colors hover:border-turquoise"
        >
          Fiche technique
        </a>
      </div>
    </div>
  </section>

  <!-- Description -->
  {d.description && (
    <section class="mx-auto max-w-[1140px] px-7 py-4">
      <h2 class="eyebrow text-xs text-turquoise">Description</h2>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-marine">{d.description}</p>
    </section>
  )}

  <!-- Caractéristiques -->
  {specs.length > 0 && (
    <section class="mx-auto max-w-[1140px] px-7 py-4">
      <h2 class="display text-2xl font-normal text-marine">Caractéristiques</h2>
      <div class="mt-5 overflow-hidden rounded-2xl border border-soft">
        <table class="w-full text-sm">
          <tbody>
            {specs.map((row, i) => (
              <tr class={i % 2 ? 'bg-mist' : 'bg-blanc'}>
                <th scope="row" class="w-1/3 px-5 py-2.5 text-left font-normal text-muted align-top">{row[0]}</th>
                <td class="px-5 py-2.5 text-marine">{row[1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-muted">
        Valeurs issues de la fiche technique du produit. Courbe de perte de charge et calculateur énergétique détaillés sur la fiche.
      </p>
    </section>
  )}

  <!-- Configurateur + Panier + Demande de devis -->
  <section class="mx-auto max-w-[1140px] px-7 py-4 scroll-mt-24" id="configurateur" data-nom={d.nom} data-code={codeBase} data-codegamme={codeGamme} data-mode={modeProduit} data-variantes={variantesConfig ? JSON.stringify(variantesConfig) : undefined} data-cadrefixe={cadreFixe?.valeur} data-cadrefixelabel={cadreFixe?.libelle} data-labelep={gamme?.labelEpaisseur}>
    <h2 class="display text-2xl font-normal text-marine">Configurer votre filtre</h2>
    <p class="mt-1 text-sm text-muted">{introConfig}</p>

    <div class="mt-4 grid gap-7 lg:grid-cols-[1.3fr_1fr]">

      <!-- Configurateur -->
      <div class="rounded-2xl border border-soft bg-white p-4 shadow-soft">
        <div class="grid gap-x-5 gap-y-2.5 sm:grid-cols-2">
          {variantesConfig && variantesConfig.length > 1 && (
            <label class="block sm:col-span-2">
              <span class="eyebrow text-[11px] text-muted">Conditionnement</span>
              <select id="inCond"
                class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise">
                {variantesConfig.map((v, i) => (
                  <option value={v.id} selected={i === 0}>{v.label}</option>
                ))}
              </select>
            </label>
          )}
          {variantesConfig && (
            <label id="wrapFormat" class="block sm:col-span-2 hidden">
              <span id="formatLabel" class="eyebrow text-[11px] text-muted">Dimensions</span>
              <select id="inFormat"
                class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise"></select>
              {/* Format unique : on affiche le libellé ici et on masque le menu ci-dessus —
                  qui reste dans la page, car c'est lui qui porte la dimension lue par le moteur. */}
              <p id="formatFixe" class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine hidden"></p>
            </label>
          )}
          <label id="wrapL" class="block">
            <span class="eyebrow text-[11px] text-muted">Largeur (mm)</span>
            <input id="inL" type="number" value={dimDefaut.largeur} min="100" max="2000" step="1"
              class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise" />
          </label>
          <label id="wrapH" class="block">
            <span class="eyebrow text-[11px] text-muted">Hauteur (mm)</span>
            <input id="inH" type="number" value={dimDefaut.hauteur} min="100" max="2000" step="1"
              class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise" />
          </label>
          {/* Épaisseur — affichée si plusieurs choix, OU pour un produit sur devis qui en
              déclare une (ex. BORA 100 mm, à capturer dans la demande de devis). */}
          {(epaisseursAffichees.length > 1 || (modeProduit === 'devis' && epaisseursAffichees.length === 1)) && (
            <label class="block">
              <span class="eyebrow text-[11px] text-muted">{gamme?.labelEpaisseur ?? 'Épaisseur'}</span>
              <select id="inEp"
                class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise">
                {epaisseursAffichees.map((ep) => (
                  <option value={ep} selected={ep === epDefaut}>{ep} mm</option>
                ))}
              </select>
            </label>
          )}
          {/* Calculable à épaisseur unique : pas de menu, mais on transmet la valeur au moteur. */}
          {modeProduit === 'calcul' && menus.epaisseurs.length === 1 && (
            <input id="inEp" type="hidden" value={menus.epaisseurs[0]} />
          )}
          {/* Efficacité — affichée dès que le calculateur a des classes pour ce produit
              (calculable OU sur devis). Pas de classe dans le calculateur → pas de champ. */}
          {menus.classes.length > 0 && !effFixe && (
            <label class="block">
              <span class="eyebrow text-[11px] text-muted">Efficacité</span>
              <select id="inEff"
                class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise">
                {menus.classes.map((c) => (
                  <option value={c.valeur} selected={c.valeur === effSelection}>{c.libelle}</option>
                ))}
              </select>
            </label>
          )}
          {effFixe && (
            <div class="block">
              <span class="eyebrow text-[11px] text-muted">Efficacité</span>
              <p id="effFixeLabel" class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine">{effFixe.libelle}</p>
              {/* La classe reste une entrée du moteur de prix : on la transmet, figée. */}
              <input id="inEff" type="hidden" value={effFixe.valeur} data-libelle={effFixe.libelle} />
            </div>
          )}
          {cadres.length > 0 && (
            <label id="wrapCadre" class="block">
              <span class="eyebrow text-[11px] text-muted">{labelCadre}</span>
              <select id="inCadre"
                class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise">
                {cadres.map((c, i) => (
                  <option value={c.valeur} selected={i === 0}>{c.libelle}</option>
                ))}
              </select>
            </label>
          )}
          {cadreFixe && (
            <div id="wrapCadre" class="block">
              <span class="eyebrow text-[11px] text-muted">{labelCadre}</span>
              <p class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine">{cadreFixe.libelle}</p>
            </div>
          )}
          <label class="block">
            <span class="eyebrow text-[11px] text-muted">Quantité</span>
            <input id="inQ" type="number" value="6" min="1" max="100000" step="1"
              class="mt-1.5 w-full rounded-xl border border-soft bg-mist px-4 py-2 text-marine outline-none focus:border-turquoise" />
          </label>
          <div class="block">
            <span class="eyebrow text-[11px] text-muted">Référence générée</span>
            <div id="genRef" class="mt-1.5 w-full rounded-xl border border-dashed border-soft bg-mist px-4 py-2 font-mono text-sm text-marine"></div>
          </div>
        </div>

        <!-- Prix + actions -->
        <div class="mt-4 rounded-2xl bg-mist px-5 py-4">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="eyebrow text-[11px] text-muted">Prix unitaire HT</span>
              <div class="display text-3xl font-normal text-marine"><span id="pUnit">—</span> €</div>
              <p class="mt-1 text-xs text-muted">Total (<span id="pQty">6</span> u.) : <span id="pTotal" class="font-medium text-marine">—</span> € HT</p>
              {modeProduit === 'calcul' && (
                <p class="mt-1 text-xs text-muted">Commande minimum : <span class="font-medium text-marine">{MIN_COMMANDE_HT} € HT</span></p>
              )}
            </div>
          </div>
          <div class="mt-4 flex flex-col gap-3 border-t border-soft pt-4 sm:flex-row">
            <button id="addBtn" type="button"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl px-6 py-2.5 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
              style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));">
              Ajouter au panier
            </button>
            <button id="addDevisBtn" type="button"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-soft bg-blanc px-6 py-2.5 text-sm font-normal text-marine transition-colors hover:border-turquoise">
              Ajouter à ma demande de devis
            </button>
          </div>
        </div>
        <p id="priceMsg" class="mt-3 text-xs text-muted"></p>
      </div>

      <!-- Panneau latéral : panier d'achat + demande de devis -->
      <div class="flex flex-col gap-6 lg:sticky lg:top-24 self-start">

        <!-- Panier d'achat -->
        <aside class="rounded-2xl border border-soft bg-white p-7 shadow-soft">
          <div class="flex items-center justify-between">
            <h3 class="display text-xl font-normal text-marine">Panier d'achat</h3>
            <span id="cartCount" class="rounded-full bg-bleu/10 px-2.5 py-0.5 text-xs font-medium text-bleu">0</span>
          </div>
          <div id="cartEmpty" class="mt-6 rounded-xl border border-dashed border-soft bg-mist px-4 py-6 text-center text-sm text-muted">
            Panier vide.<br />Configurez un filtre puis « Ajouter au panier ».
          </div>
          <ul id="cartList" class="mt-5 hidden divide-y divide-soft"></ul>
          <div id="cartFooter" class="mt-5 hidden">
            <div class="flex items-center justify-between border-t border-soft pt-4">
              <span class="text-sm text-muted">Total HT</span>
              <span class="display text-2xl font-normal text-marine"><span id="grandTotal">0</span> €</span>
            </div>
            <p class="mt-1 text-right text-xs text-muted">TVA et frais de port calculés à l'étape suivante.</p>
            <a href="/panier"
              class="mt-4 flex w-full items-center justify-center rounded-xl px-6 py-2.5 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)]"
              style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));">
              Voir le panier &amp; commander →
            </a>
          </div>
        </aside>

        <!-- Demande de devis (liste multi-produits) -->
        <aside class="rounded-2xl border border-soft bg-white p-7 shadow-soft">
          <div class="flex items-center justify-between">
            <h3 class="display text-xl font-normal text-marine">Ma demande de devis</h3>
            <span id="devisCount" class="rounded-full bg-turquoise/10 px-2.5 py-0.5 text-xs font-medium text-turquoise">0</span>
          </div>
          <p class="mt-1 text-xs text-muted">Plusieurs filtres possibles · prix étudié sur devis.</p>

          <div id="devisEmpty" class="mt-5 rounded-xl border border-dashed border-soft bg-mist px-4 py-6 text-center text-sm text-muted">
            Aucun filtre dans la demande.<br />Configurez un filtre puis « Ajouter à ma demande de devis ».
          </div>
          <ul id="devisList" class="mt-5 hidden divide-y divide-soft"></ul>

          <!-- Vers la page de demande de devis (les coordonnées et l'envoi y sont saisis) -->
          <div id="devisStep1" class="mt-5 hidden">
            <a href="/devis" class="flex w-full items-center justify-center rounded-xl px-6 py-2.5 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)]"
              style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));">
              Voir ma demande de devis →
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Appel final -->
  <section class="mx-auto max-w-[1140px] px-7 py-8">
    <div class="rounded-3xl border border-soft bg-mist px-8 py-12 text-center">
      <h2 class="display text-2xl font-normal text-marine">Un projet plus large autour de {d.nom} ?</h2>
      <p class="mx-auto mt-2 max-w-xl text-muted">
        Pour les gros volumes, appels d'offres ou conditions négociées, expliquez-nous votre besoin : nous revenons vers vous avec une proposition adaptée.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-normal text-blanc shadow-[0_10px_24px_-10px_rgba(8,151,165,0.55)] transition-transform hover:-translate-y-0.5"
        style="background-image: linear-gradient(135deg, var(--color-bleu), var(--color-turquoise));"
      >
        Nous expliquer votre besoin →
      </a>
    </div>
  </section>

  <script>
    // Bloc B2 : le configurateur appelle le VRAI moteur de prix (calculerPrix).
    // Ce <script> est groupé/empaqueté par Astro (pas `is:inline`) afin de pouvoir
    // importer le moteur — qui embarque les tables tarifaires pour un calcul instantané.
    import { calculerPrix } from '../../lib/pricing';
    import { CADRE_SUFFIXE } from '../../lib/pricing/produits-gammes';
    import { addItem, getCart, removeItem, onCartChange } from '../../lib/cart';
    import { addDevisItem, getDevis, removeDevisItem, onDevisChange } from '../../lib/devis';

    (function () {
      const root = document.getElementById('configurateur');
      if (!root) return;
      const nom = root.dataset.nom || 'Filtre';
      const code = root.dataset.code || 'NET';
      const codeGamme = root.dataset.codegamme || '';
      const mode = root.dataset.mode || 'devis';   // "calcul" = prix instantané · "devis" = sur devis
      const $ = (id) => document.getElementById(id);
      const eur = (n) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      // --- Conditionnements multiples (ex. NETFIBRE : panneau / rouleau) ---
      let variantes = null;
      try { variantes = root.dataset.variantes ? JSON.parse(root.dataset.variantes) : null; } catch (e) { variantes = null; }
      let activeVar = variantes && variantes.length ? variantes[0] : null;

      function setEffOptions(classes, selected) {
        const el = $('inEff');
        if (!el) return;
        // Efficacité figée (champ caché, cf. `effFixe`) : rien à reconstruire, on remet à jour
        // la valeur et le libellé au cas où le conditionnement changerait la classe.
        if (el.tagName !== 'SELECT') {
          const c = (classes || [])[0];
          if (!c) return;
          el.value = c.valeur;
          el.dataset.libelle = c.libelle;
          const p = $('effFixeLabel');
          if (p) p.textContent = c.libelle;
          return;
        }
        el.innerHTML = (classes || []).map((c) =>
          '<option value="' + c.valeur + '"' + (c.valeur === selected ? ' selected' : '') + '>' + c.libelle + '</option>'
        ).join('');
      }
      function setFormatOptions(formats) {
        const liste = formats || [];
        // Format pré-sélectionné : celui marqué `defaut` (ex. rouleau 20 m × 2 m), sinon le
        // premier — l'ordre de la liste sert la lecture, il ne dit pas le format courant.
        const iDefaut = Math.max(0, liste.findIndex((f) => f.defaut));
        const sel = $('inFormat');
        sel.innerHTML = liste.map((f, i) =>
          '<option value="' + i + '"' + (i === iDefaut ? ' selected' : '') + '>' + f.label + '</option>'
        ).join('');
        // Un seul format = pas un choix : on masque le menu et on affiche le libellé. Le menu
        // reste rempli et sélectionné — `readCfg` y lit la dimension envoyée au moteur.
        const unSeul = liste.length === 1;
        sel.classList.toggle('hidden', unSeul);
        const fixe = $('formatFixe');
        if (fixe) {
          fixe.classList.toggle('hidden', !unSeul);
          fixe.textContent = unSeul ? liste[0].label : '';
        }
      }
      // Bascule un conditionnement : montre/masque dimensions ↔ format, recharge les
      // efficacités tarifées de la variante, puis recalcule le prix.
      function applyVariante(v) {
        activeVar = v;
        const formats = v.saisie === 'formats';
        $('wrapL') && $('wrapL').classList.toggle('hidden', formats);
        $('wrapH') && $('wrapH').classList.toggle('hidden', formats);
        $('wrapFormat') && $('wrapFormat').classList.toggle('hidden', !formats);
        if (formats) {
          if ($('formatLabel') && v.labelChamp) $('formatLabel').textContent = v.labelChamp;
          setFormatOptions(v.formats || []);
        }
        setEffOptions(v.classes || [], v.effSelection);
        // Variante sans cadre (ex. recharge LUMEN : cassettes seules, le support est conservé) :
        // le champ « Cadre » du produit ne la concerne pas.
        $('wrapCadre') && $('wrapCadre').classList.toggle('hidden', !!v.sansCadre);
        // Épaisseurs propres à la variante (ex. NETBAG S : 380/550 en standard — tarifés —
        // contre les 4 longueurs de la fiche en sur-mesure, qui part en devis).
        if (v.epaisseurs && $('inEp')) {
          const garde = $('inEp').value;
          $('inEp').innerHTML = v.epaisseurs.map((ep) =>
            '<option value="' + ep + '"' + (String(ep) === garde ? ' selected' : '') + '>' + ep + ' mm</option>'
          ).join('');
        }
        refresh();
      }

      // Message lisible pour un statut non vendable renvoyé par le moteur.
      function messageStatut(r) {
        // `classe_indisponible` ne veut PAS dire indisponible : la combinaison est bien proposée
        // au menu, elle n'a simplement pas de prix catalogue en ligne, et le bouton de devis
        // reste actif juste en dessous. Annoncer une indisponibilité serait faux (déc. PA
        // 15/08/2026). Traité AVANT le passe-plat : le message du moteur, factuel, sert au
        // diagnostic mais ne s'adresse pas au client.
        if (r.statut === 'classe_indisponible') return 'Prix sur devis dans ce format — ajoutez-le à votre demande.';
        if (r.message) return r.message;
        switch (r.statut) {
          case 'sur_devis': return 'Produit proposé sur devis — ajoutez-le à votre demande.';
          case 'hors_fabrication': return 'Dimensions hors des limites de fabrication.';
          case 'quantite_insuffisante': return r.quantiteMini ? ('Quantité minimale : ' + r.quantiteMini + '.') : 'Quantité insuffisante.';
          case 'gamme_inconnue': return 'Produit non disponible à la commande en ligne.';
          default: return '';
        }
      }

      // Affiche (ou efface) le prix et pilote l'état du bouton « Ajouter au panier ».
      function afficherPrix(unit, total, msg) {
        const ok = unit != null;
        $('pUnit').textContent = ok ? eur(unit) : '—';
        $('pTotal').textContent = ok ? eur(total) : '—';
        $('priceMsg').textContent = msg || '';
        const btn = $('addBtn');
        btn.disabled = !ok;
        btn.classList.toggle('opacity-40', !ok);
        btn.classList.toggle('cursor-not-allowed', !ok);
      }

      // Libellé court d'une config, pour la ligne de panier (efficacité · dimensions · cadre).
      // Dimensions = L×H×épaisseur (ex. "592×592×48 mm"), ou le format pour les produits à formats.
      function detailLigne(c) {
        const dims = c.formatLabel
          ? c.formatLabel
          : (c.L + '×' + c.H + (c.ep ? '×' + c.ep : '') + ' mm');
        return [c.effLabel, dims, c.cadreLabel].filter(Boolean).join(' · ');
      }

      function readCfg() {
        let L, H, formatLabel = null;
        if (activeVar && activeVar.saisie === 'formats') {
          // Rouleau : les dimensions viennent du format choisi (pas d'une saisie en mm).
          const f = (activeVar.formats || [])[+(($('inFormat') || {}).value) || 0];
          L = f ? f.largeur : 0;
          H = f ? f.hauteur : 0;
          formatLabel = f ? f.label : '';
        } else {
          L = Math.max(100, +$('inL').value || 0);
          H = Math.max(100, +$('inH').value || 0);
        }
        // Le menu Épaisseur peut être absent (gammes sans choix d'épaisseur, ex. NETFIL) → ep = null.
        const epEl = $('inEp');
        const ep = epEl ? (+epEl.value || null) : null;
        // Le menu Efficacité peut être absent (produits sur devis : pas de prix).
        const effEl = $('inEff');
        const eff = effEl ? effEl.value : '';
        // Menu → libellé de l'option choisie ; efficacité figée (champ caché) → `data-libelle`.
        const effOpt = effEl && effEl.selectedOptions ? effEl.selectedOptions[0] : null;
        const effLabel = effOpt ? effOpt.text : (effEl?.dataset.libelle ?? '');
        // Trois cas : menu (cadre au choix), cadre imposé lu sur le conteneur (affiché en
        // lecture seule, il compte quand même dans la référence), ou rien (ex. NETFIBRE).
        const cadreEl = $('inCadre');
        // Variante sans cadre (ex. recharge LUMEN : cassettes seules) : ni suffixe de
        // référence, ni « · Plastique » sur la ligne de panier.
        const varSansCadre = !!(activeVar && activeVar.sansCadre);
        const cadreVal = varSansCadre ? null : (cadreEl ? cadreEl.value : (root.dataset.cadrefixe || null));
        // Suffixe lu dans la table partagée (jamais recopié ici) : un cadre sans suffixe
        // tranché est refusé en amont par les tests.
        const cadre = cadreVal ? CADRE_SUFFIXE[cadreVal] ?? null : null;
        // Libellé lu dans le menu (et non déduit de la valeur) : un même cadre `pp` s'affiche
        // « Polypropylène » ou « Plastique » selon la fiche du produit.
        const cadreLabel = varSansCadre ? null : (cadreEl?.selectedOptions[0]?.text ?? root.dataset.cadrefixelabel ?? null);
        const qty = Math.max(1, +$('inQ').value || 1);
        const codeUsed = activeVar ? activeVar.code : codeGamme;
        // Le cadre est-il un CHOIX du client (menu) ou une donnée imposée ? Seul un choix doit
        // apparaître dans la référence d'un produit à formats standard — cf. refRef().
        const cadreAuChoix = !!cadreEl && !varSansCadre;
        return { L, H, ep, eff, effLabel, cadre, cadreLabel, cadreAuChoix, qty, codeUsed, formatLabel };
      }

      function refRef(c) {
        // Base de référence propre à la variante (ex. « Recharge pour NETPAK S LUMEN ») :
        // sans elle, filtre complet et recharge partageraient la même référence au panier.
        const base0 = (activeVar && activeVar.refBase) || code;
        const effPart = c.eff ? ('-' + c.eff) : '';
        const cadrePart = c.cadre ? ('-' + c.cadre) : '';
        // Branche « formats standard » : le suffixe de cadre n'y était pas ajouté du tout. Sans
        // lui, NETCEL V NIVAL plastique et acier galvanisé — deux filtres différents au MÊME prix
        // — portaient la même référence, et rien ne disait à l'atelier lequel monter.
        // Restreint au cadre AU CHOIX : l'ajouter aussi pour un cadre imposé changerait les
        // références de NETPAK S AZUR et NETPAK S LUMEN, deux produits figés (écart de convention
        // avec la branche « dimensions libres », qui l'ajoute toujours — consigné à la CHECKLIST).
        if (c.formatLabel) {
          const cadreFmt = c.cadreAuChoix ? cadrePart : '';
          // L'épaisseur n'entre dans la référence que lorsqu'elle est un CHOIX indépendant du
          // format (variante à `epaisseurs` propres, ex. NETBAG S : longueur de poche 380 ou
          // 550 mm, prix différents). Ailleurs le libellé la porte déjà (« 287 × 592 × 292 mm »)
          // ou elle n'a pas de sens (rouleau NETFIBRE) — l'ajouter ferait une référence fausse.
          const base = c.formatLabel.replace(/\s+/g, '');
          const epIndep = activeVar && activeVar.epaisseurs && c.ep != null;
          return epIndep
            ? `${base0}${effPart}-${base.replace(/mm$/, '')}×${c.ep}mm${cadreFmt}`
            : `${base0}${effPart}-${base}${cadreFmt}`;
        }
        const epPart = c.ep != null ? ('x' + c.ep) : '';
        return `${base0}${effPart}-${c.L}x${c.H}${epPart}${cadrePart}`;
      }

      // Cadres du produit, capturés à l'ouverture : le menu est ensuite FILTRÉ selon le format
      // choisi, certains cadres n'existant pas dans tous les formats (ex. NETCEL V NIVAL, dont
      // les cadres 592 ne sont fabriqués qu'en acier galvanisé).
      const CADRES_TOUS = [...(($('inCadre') || {}).options || [])]
        .map((o) => ({ valeur: o.value, libelle: o.text }));

      function majCadresSelonFormat() {
        const sel = $('inCadre');
        if (!sel || !CADRES_TOUS.length) return;
        const f = activeVar && activeVar.saisie === 'formats'
          ? (activeVar.formats || [])[+(($('inFormat') || {}).value) || 0]
          : null;
        const permis = f && f.cadres && f.cadres.length ? f.cadres : null;
        const liste = permis ? CADRES_TOUS.filter((c) => permis.indexOf(c.valeur) >= 0) : CADRES_TOUS;
        // Rien d'autorisé (donnée incohérente) : on laisse le menu complet plutôt que vide,
        // un menu vide enverrait un cadre `null` au panier sans que personne ne le voie.
        if (!liste.length) return;
        const memes = liste.length === sel.options.length
          && liste.every((c, i) => sel.options[i].value === c.valeur);
        if (memes) return;
        const avant = sel.value;
        sel.innerHTML = liste
          .map((c) => '<option value="' + c.valeur + '">' + c.libelle + '</option>').join('');
        sel.value = liste.some((c) => c.valeur === avant) ? avant : liste[0].valeur;
      }

      // Calcule et affiche le prix réel via le moteur. Renvoie { c, unit, ok }.
      function refresh() {
        majCadresSelonFormat();
        const c = readCfg();
        $('pQty').textContent = c.qty;
        $('genRef').textContent = refRef(c);

        // Produit « sur devis » : aucun prix public, on oriente vers la demande de devis.
        if (mode !== 'calcul') {
          afficherPrix(null, null, 'Ce produit est proposé sur devis. Ajoutez-le à votre demande de devis.');
          return { c, unit: null, ok: false };
        }

        // Variante à épaisseurs déclarées (ex. NETBAG S : la longueur de poche fait le prix) :
        // une épaisseur absente ne doit jamais partir au moteur avec le « 48 neutre » ci-dessous —
        // refus explicite plutôt qu'un statut hors_fabrication trompeur (revue 27/07).
        if (activeVar && activeVar.epaisseurs && c.ep == null) {
          afficherPrix(null, null, 'Sélectionnez une ' + (root.dataset.labelep || 'épaisseur').toLowerCase() + '.');
          return { c, unit: null, ok: false };
        }

        const r = calculerPrix({
          codeGamme: c.codeUsed, // code de la variante active (ex. NETFIBRE panneau=4 / rouleau=5)
          largeur_mm: c.L,
          hauteur_mm: c.H,
          profondeur_mm: c.ep ?? 48, // valeur positive neutre pour les gammes sans épaisseur (le moteur exige > 0 mais l'ignore ensuite via epCompatible)
          classe: c.eff,
          quantite: c.qty,
        });

        if (r.statut === 'ok') {
          const total = r.prixUnitaireHT * c.qty;
          afficherPrix(
            r.prixUnitaireHT, total,
            'Prix unitaire HT valable ' + r.dureeValiditeJours + " jours · TVA et frais de port à l'étape suivante.",
          );
          return { c, unit: r.prixUnitaireHT, ok: true };
        }

        // Statut non vendable (sur devis, hors format, classe indisponible…) : pas de prix inventé.
        afficherPrix(null, null, messageStatut(r));
        return { c, unit: null, ok: false };
      }

      // ---- Panier d'achat ----
      // Mini-panier de la page produit : reflète le VRAI panier (partagé entre toutes les pages).
      function renderCart() {
        const items = getCart();
        $('cartCount').textContent = items.reduce((s, i) => s + i.qty, 0);
        const empty = items.length === 0;
        $('cartEmpty').classList.toggle('hidden', !empty);
        $('cartList').classList.toggle('hidden', empty);
        $('cartFooter').classList.toggle('hidden', empty);
        const list = $('cartList');
        list.innerHTML = '';
        let grand = 0;
        items.forEach((it) => {
          grand += it.unit * it.qty;
          const li = document.createElement('li');
          li.className = 'flex items-start justify-between gap-3 py-3';
          li.innerHTML =
            '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-marine">' + it.ref + '</p>' +
              '<p class="text-xs text-muted">' + it.qty + ' u. × ' + eur(it.unit) + ' €</p>' +
            '</div>' +
            '<div class="flex items-center gap-3 shrink-0">' +
              '<span class="text-sm font-medium text-marine">' + eur(it.unit * it.qty) + ' €</span>' +
              '<button data-rm="' + it.ref + '" class="text-muted hover:text-bleu" aria-label="Retirer">✕</button>' +
            '</div>';
          list.appendChild(li);
        });
        $('grandTotal').textContent = eur(grand);
        list.querySelectorAll('[data-rm]').forEach((b) =>
          b.addEventListener('click', () => removeItem(b.dataset.rm))
        );
      }

      // ---- Demande de devis (persistante, partagée entre toutes les pages, sans prix) ----
      function renderDevis() {
        const items = getDevis();
        $('devisCount').textContent = items.reduce((s, i) => s + i.qty, 0);
        const empty = items.length === 0;
        $('devisEmpty').classList.toggle('hidden', !empty);
        $('devisList').classList.toggle('hidden', empty);
        $('devisStep1').classList.toggle('hidden', empty);
        const list = $('devisList');
        list.innerHTML = '';
        items.forEach((it) => {
          const li = document.createElement('li');
          li.className = 'flex items-start justify-between gap-3 py-3';
          li.innerHTML =
            '<div class="min-w-0">' +
              '<p class="font-mono text-xs text-marine">' + it.ref + '</p>' +
              '<p class="text-xs text-muted">' + [it.qty + ' u.', it.detail, 'prix sur devis'].filter(Boolean).join(' · ') + '</p>' +
            '</div>' +
            '<button data-rmd="' + it.ref + '" class="shrink-0 text-muted hover:text-turquoise" aria-label="Retirer">✕</button>';
          list.appendChild(li);
        });
        list.querySelectorAll('[data-rmd]').forEach((b) =>
          b.addEventListener('click', () => removeDevisItem(b.dataset.rmd))
        );
      }

      ['inL', 'inH', 'inEp', 'inEff', 'inCadre', 'inQ', 'inFormat'].forEach((id) =>
        $(id)?.addEventListener('input', refresh)
      );
      // Changer de conditionnement (panneau ↔ rouleau) bascule la saisie + les menus.
      $('inCond')?.addEventListener('input', () => {
        const v = (variantes || []).find((x) => x.id === $('inCond').value);
        if (v) applyVariante(v);
      });

      $('addBtn').addEventListener('click', () => {
        const { c, unit, ok } = refresh();
        if (!ok || unit == null) return;   // pas d'ajout sans prix (sur devis, hors format, classe indispo…)
        addItem({
          ref: refRef(c), produit: nom, qty: c.qty, unit, detail: detailLigne(c),
          // config complète → re-calcul du prix si la quantité change au panier (paliers)
          demande: { codeGamme: c.codeUsed, largeur_mm: c.L, hauteur_mm: c.H, profondeur_mm: c.ep ?? 48, classe: c.eff },
        });
        // renderCart() est rappelé automatiquement via onCartChange.
      });

      $('addDevisBtn').addEventListener('click', () => {
        const { c } = refresh();
        addDevisItem({ ref: refRef(c), produit: nom, qty: c.qty, detail: detailLigne(c) });
        // renderDevis() est rappelé automatiquement via onDevisChange (envoi = page /devis).
      });

      // Démarrage : si le produit a des conditionnements, on applique celui par défaut
      // (qui prépare la saisie + les menus puis recalcule) ; sinon simple premier calcul.
      if (activeVar) applyVariante(activeVar); else refresh();
      renderCart();
      onCartChange(renderCart); // le mini-panier suit le vrai panier (ajouts/retraits d'où qu'ils viennent)
      renderDevis();
      onDevisChange(renderDevis); // la mini-liste de devis suit la demande persistante
    })();
  </script>
</BaseLayout>
